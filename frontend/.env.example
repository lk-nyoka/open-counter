# Leave VITE_API_BASE empty: in development Vite proxies /api, /auth and /mcp (see vite.config.ts),
# and in production the Worker serves the app on the same origin as the API.
VITE_API_BASE=""
# Where `npm run dev` sends API calls. Default: the local Worker from `npm run dev:local` in the repo root.
OPEN_COUNTER_API="http://localhost:8792"
